# ── Load Balancer ──────────────────────────────
LB_PORT=8081
CLIENT_URL=http://localhost:5173

# ── Algorithm ──────────────────────────────────
LB_ALGORITHM=ROUND_ROBIN

# Options:
# ROUND_ROBIN
# LEAST_CONNECTIONS
# WEIGHTED_ROUND_ROBIN
# IP_HASH

# ── Health Check ───────────────────────────────
HEALTH_CHECK_INTERVAL=10000
HEALTH_CHECK_THRESHOLD=500
HEALTH_CHECK_TIMEOUT=3000

# ── Sticky Sessions ────────────────────────────
ENABLE_STICKY_SESSIONS=false

# ── Backend Servers ────────────────────────────
SERVER_1=http://localhost:4000
SERVER_1_WEIGHT=1

SERVER_2=http://localhost:4001
SERVER_2_WEIGHT=3

SERVER_3=http://localhost:4002
SERVER_3_WEIGHT=1

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=project__is_a_great_one_i_guess