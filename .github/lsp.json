{
    "lspServers": {
        "typescript": {
            "command": "typescript-language-server",
            "args": ["--stdio"],
            "fileExtensions": {
                ".ts": "typescript",
                ".tsx": "typescriptreact",
                ".js": "javascript",
                ".jsx": "javascriptreact"
            },
            "initializationOptions": {
                "tsserver": { "path": "./client/node_modules/typescript/lib/tsserver.js" }
            }
        }
    }
}